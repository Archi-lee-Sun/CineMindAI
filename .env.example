# Copy only if .env does not already exist. All values here are examples.
ENVIRONMENT=development
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DB_HOST/DB_NAME?sslmode=require&channel_binding=require
# Optional direct endpoint for migration tools; never alter runtime URI parameters.
# MIGRATION_DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DIRECT_DB_HOST/DB_NAME?sslmode=require&channel_binding=require

# Generate a unique local key with the README command; never commit the real key.
VERIFICATION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
VERIFICATION_TTL_SECONDS=600
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=cinemind_session
# False is accepted only for loopback development writes. Use true for HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
TRUSTED_ORIGINS=["http://127.0.0.1:8001","http://localhost:8001"]

# Local Mailpit: SMTP has no credentials and deliberately uses no TLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM="CineMind AI <noreply@cinemind.example>"
# For a real provider use starttls or ssl, then set both credentials locally:
# SMTP_USERNAME=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_TIMEOUT_SECONDS=5

DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
AUTH_RATE_WINDOW_SECONDS=60
AUTH_IP_LIMIT=30
AUTH_ACCOUNT_LIMIT=10
DELIVERY_ACCOUNT_LIMIT=3

# Tests refuse remote databases and never use DATABASE_URL as a fallback.
# TEST_DATABASE_URL=postgresql://cinemind_test@127.0.0.1:55432/cinemind_test
